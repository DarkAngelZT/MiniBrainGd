#!/usr/bin/env python

import os

from SCons.Script import Default, Environment, Variables


variables = Variables()
variables.Add("llvm_bin", "Path to the LLVM/MinGW bin directory on Windows", "")
env = Environment(variables=variables, ENV=os.environ)

if env["PLATFORM"] == "win32":
    llvm_bin = env["llvm_bin"]
    if not llvm_bin:
        raise RuntimeError("llvm_bin is required on Windows")

    compiler = os.path.join(llvm_bin, "clang++.exe")
    if not os.path.isfile(compiler):
        raise RuntimeError("clang++.exe was not found in llvm_bin: " + llvm_bin)

    env.Replace(CC=os.path.join(llvm_bin, "clang.exe"))
    env.Replace(CXX=compiler)
    env.Replace(LINK=compiler)

env.Append(
    CXXFLAGS=["-std=c++17", "-O0", "-g3", "-UNDEBUG"],
    CPPPATH=[
        "src",
        "MiniBrain/Source",
        "MiniBrain/Source/ThirdParty",
    ],
)

test_objects = [
    env.Object(
        target="tests/build/minibrain_gd_tests.o",
        source="tests/minibrain_gd_tests.cpp",
    ),
    env.Object(
        target="tests/build/StatePooling.o",
        source="src/StatePooling.cpp",
    ),
    env.Object(
        target="tests/build/EmbeddingLayer.o",
        source="src/EmbeddingLayer.cpp",
    ),
]

test_program = env.Program(
    target="tests/bin/minibrain_gd_tests",
    source=test_objects,
)

Default(test_program)
